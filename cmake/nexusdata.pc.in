prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: nexusdata
Description: High-performance C++20 AI data loading and preparation library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lnexusdata
Cflags: -I${includedir}
