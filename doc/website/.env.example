# Optional public env for the NexusData docs site.
# Copy to `.env.local` for local overrides. Never commit secrets.

# Canonical site URL (sitemap, OG, metadataBase)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Dev-only: force geo country for locale negotiation (TR → tr, else → en)
# DEV_FORCE_COUNTRY=TR

# Optional privacy-friendly analytics (off by default — leave empty)
# NEXT_PUBLIC_ANALYTICS_PROVIDER=
# NEXT_PUBLIC_ANALYTICS_SRC=
