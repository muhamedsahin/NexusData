#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = "C:\Program Files\Microsoft Visual Studio\2022\Preview\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe" --regenerate-during-build -SC:\Users\muham\Desktop\Nexus\lib\NexusData -BC:\Users\muham\Desktop\Nexus\lib\NexusData\build-arrow
  description = Re-running CMake...
  generator = 1


