rule CLEAN
  command = C:\PROGRA~1\MICROS~3\2022\Preview\Common7\IDE\COMMON~1\MICROS~1\CMake\Ninja\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


